{
  "name": "@mocco/cli",
  "version": "0.2.0",
  "description": "The mocco CLI: publish OTA updates from CI, and work with Mocco from a terminal.",
  "type": "module",
  "bin": {
    "mocco": "./dist/cli.js"
  },
  "exports": {
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    },
    "./publish": {
      "types": "./dist/publish.d.ts",
      "import": "./dist/publish.js"
    },
    "./promote": {
      "types": "./dist/promote.d.ts",
      "import": "./dist/promote.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "node ./bin/mocco.mjs",
    "lint": "eslint . --max-warnings 0",
    "ts-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/code-signing-certificates": "0.0.7",
    "@mocco/sdk-core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mocco/common": "workspace:*",
    "eslint": "10.6.0",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@mocco/js",
  "version": "0.2.0",
  "description": "Mocco for the browser: one SDK, product features as subpath exports.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mocco/source": "./src/mocco-js.ts",
      "types": "./dist/mocco-js.d.ts",
      "import": "./dist/mocco-js.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "ts-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mocco/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "eslint": "10.6.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}

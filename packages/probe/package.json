{
  "name": "@mocco/probe",
  "version": "0.0.0",
  "description": "The Mocco status probe: leases uptime checks from Mocco, runs them from where it is, and reports the results.",
  "type": "module",
  "bin": {
    "mocco-probe": "./dist/cli.js"
  },
  "exports": {
    "./create-agent": {
      "@mocco/source": "./src/create-agent.ts",
      "types": "./dist/create-agent.d.ts",
      "import": "./dist/create-agent.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "ts-check": "tsc --noEmit",
    "test": "NODE_EXTRA_CA_CERTS=src/testing/fixture-cert.pem vitest run"
  },
  "dependencies": {
    "undici": "7.28.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mocco/common": "workspace:*",
    "@types/node": "22.20.0",
    "eslint": "10.6.0",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

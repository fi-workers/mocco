{
  "name": "@mocco/openfeature-web",
  "version": "0.1.0",
  "description": "An OpenFeature web provider for Mocco feature flags: OFREP evaluation with Mocco's change stream and an offline cache.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mocco/source": "./src/openfeature-web.ts",
      "types": "./dist/openfeature-web.d.ts",
      "import": "./dist/openfeature-web.js",
      "require": "./dist/openfeature-web.cjs"
    }
  },
  "main": "./dist/openfeature-web.cjs",
  "module": "./dist/openfeature-web.js",
  "types": "./dist/openfeature-web.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "ts-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mocco/sdk-core": "workspace:*",
    "@openfeature/ofrep-web-provider": "^0.4.3"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.10.0"
  },
  "devDependencies": {
    "@openfeature/core": "1.12.0",
    "@openfeature/web-sdk": "1.10.0",
    "eslint": "10.6.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "$id": "https://mocco.club/flags.schema.json",
  "title": ".mocco/flags.yml (v1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "flags": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "default": "boolean",
            "type": "string",
            "enum": [
              "boolean",
              "string",
              "number",
              "json"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "lifecycle": {
            "default": "temporary",
            "type": "string",
            "enum": [
              "temporary",
              "permanent"
            ]
          },
          "client_visible": {
            "default": false,
            "type": "boolean"
          },
          "variants": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
            },
            "additionalProperties": {}
          },
          "off_variant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "targets": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "default": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                },
                "rules": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "when": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "attribute": {
                                    "type": "string",
                                    "maxLength": 100,
                                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*$"
                                  },
                                  "op": {
                                    "type": "string",
                                    "enum": [
                                      "in",
                                      "not_in",
                                      "starts_with",
                                      "ends_with",
                                      "lt",
                                      "lte",
                                      "gt",
                                      "gte",
                                      "semver_eq",
                                      "semver_lt",
                                      "semver_lte",
                                      "semver_gt",
                                      "semver_gte"
                                    ]
                                  },
                                  "values": {
                                    "minItems": 1,
                                    "maxItems": 1000,
                                    "type": "array",
                                    "items": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "maxLength": 500
                                        },
                                        {
                                          "type": "number"
                                        }
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "attribute",
                                  "op",
                                  "values"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "segment": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
                                  },
                                  "negate": {
                                    "type": "boolean"
                                  }
                                },
                                "required": [
                                  "segment"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          {
                            "minItems": 1,
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "attribute": {
                                      "type": "string",
                                      "maxLength": 100,
                                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*$"
                                    },
                                    "op": {
                                      "type": "string",
                                      "enum": [
                                        "in",
                                        "not_in",
                                        "starts_with",
                                        "ends_with",
                                        "lt",
                                        "lte",
                                        "gt",
                                        "gte",
                                        "semver_eq",
                                        "semver_lt",
                                        "semver_lte",
                                        "semver_gt",
                                        "semver_gte"
                                      ]
                                    },
                                    "values": {
                                      "minItems": 1,
                                      "maxItems": 1000,
                                      "type": "array",
                                      "items": {
                                        "anyOf": [
                                          {
                                            "type": "string",
                                            "maxLength": 500
                                          },
                                          {
                                            "type": "number"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  "required": [
                                    "attribute",
                                    "op",
                                    "values"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "segment": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
                                    },
                                    "negate": {
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "segment"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          }
                        ]
                      },
                      "serve": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "rollout": {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                                },
                                "additionalProperties": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 100000
                                }
                              }
                            },
                            "required": [
                              "rollout"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "when",
                      "serve"
                    ],
                    "additionalProperties": false
                  }
                },
                "rollout": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                }
              },
              "required": [
                "default"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "flags"
  ],
  "additionalProperties": false
}

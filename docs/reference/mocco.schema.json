{
  "$id": "https://mocco.club/mocco.schema.json",
  "title": ".mocco.yml (v1 & v2)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "pipeline": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run": {
                "type": "string",
                "minLength": 1
              },
              "executor": {
                "type": "string",
                "minLength": 1
              },
              "with": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "run",
              "executor"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "pipeline",
        "steps"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 2
        },
        "pipeline": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "run": {
                    "type": "string",
                    "minLength": 1
                  },
                  "executor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "with": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "kind": {
                    "type": "string",
                    "const": "step"
                  }
                },
                "required": [
                  "run",
                  "executor",
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "gate"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resume": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "minLength": 1
                        },
                        "count": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "role",
                        "count"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "prevent_self": {
                    "type": "boolean"
                  },
                  "reason_required": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "resume"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "version",
        "pipeline",
        "steps"
      ],
      "additionalProperties": false
    }
  ]
}
